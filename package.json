    "boss:import:url": "node boss/boss-import-url.mjs",
    "boss:chrome:extract": "node boss/boss-chrome-extract.mjs",
    "boss:extract:daily": "node boss/boss-extract-driver.mjs",
    "boss:extract:daily:all": "node boss/boss-extract-driver.mjs --all",
    "boss:chrome:apply": "node boss/boss-chrome-apply.mjs",
    "boss:send:one": "node boss/boss-chrome-apply.mjs",
    "boss:scan": "node boss/boss-scan.mjs",
    "boss:scan:manual": "node boss/boss-scan.mjs --manual",
    "boss:score": "node boss/boss-score.mjs",
    "boss:quota": "node boss/boss-quota.mjs",
    "boss:fill": "node boss/boss-fill.mjs",
    "boss:review": "node boss/boss-review.mjs",
